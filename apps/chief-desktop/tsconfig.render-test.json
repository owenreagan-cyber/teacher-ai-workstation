{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "rootDir": "src",
    "outDir": "out-test"
  },
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx", "src/shared/**/*.ts"],
  "exclude": ["src/renderer/main.tsx"]
}
