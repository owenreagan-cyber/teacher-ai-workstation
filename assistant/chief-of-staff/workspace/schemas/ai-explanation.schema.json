{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Evidence Explanation",
  "type": "object",
  "required": ["entity_id", "source_systems", "evidence", "confidence", "review_state", "uncertainty", "authority", "action_authority"],
  "properties": {
    "entity_id": {"type": "string"},
    "source_systems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "review_state": {"enum": ["unreviewed", "reviewed", "rejected"]},
    "uncertainty": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authority": {"enum": ["canonical", "deployment", "mirror", "backup", "archive", "unknown"]},
    "action_authority": {"const": "none"}
  },
  "additionalProperties": false
}
