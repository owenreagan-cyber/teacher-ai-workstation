{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic Future AI Output Candidate",
  "type": "object",
  "required": ["schema_version", "response_id", "claims", "uncertainties", "requested_actions", "authority_effect", "validation_state"],
  "properties": {
    "schema_version": {"const": 1},
    "response_id": {"type": "string", "pattern": "^ai-response:[a-z0-9][a-z0-9._:-]*$"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "statement", "claim_type", "evidence_refs", "confidence"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^claim:[a-z0-9][a-z0-9._:-]*$"},
          "statement": {"type": "string"},
          "claim_type": {"enum": ["known", "evidence", "inference", "unknown", "recommendation"]},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]}
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "requested_actions": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "authority_effect": {"const": "none"},
    "validation_state": {"const": "candidate_not_executed"}
  },
  "additionalProperties": false
}
