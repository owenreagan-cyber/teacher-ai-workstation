{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Classification Policy Registry",
  "type": "object",
  "required": ["schema_version", "registry_type", "phase", "dimensions", "authority_scopes", "basis_contract", "evidence_precedence", "policies"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_type": {"const": "classification_policy"},
    "phase": {"const": "phase_b_static_policy"},
    "dimensions": {
      "type": "object",
      "required": ["workspace_role", "data_sensitivity", "authority_role", "lifecycle"],
      "properties": {
        "workspace_role": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "data_sensitivity": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "authority_role": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "lifecycle": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "basis_contract": {
      "type": "object",
      "required": ["required_fields", "allowed_kinds", "evidence_required"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
        "allowed_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "evidence_required": {"const": true}
      },
      "additionalProperties": false
    },
    "evidence_precedence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "policies": {
      "type": "object",
      "required": ["audience_is_not_data_sensitivity", "filename_or_age_can_finalize_destructive_classification", "unknown_preferred_over_unsupported_claim", "newer_implies_canonical", "backup_can_become_canonical_by_timestamp", "observed_or_inferred_relationship_implies_authority"],
      "properties": {
        "audience_is_not_data_sensitivity": {"const": true},
        "filename_or_age_can_finalize_destructive_classification": {"const": false},
        "unknown_preferred_over_unsupported_claim": {"const": true},
        "newer_implies_canonical": {"const": false},
        "backup_can_become_canonical_by_timestamp": {"const": false},
        "observed_or_inferred_relationship_implies_authority": {"const": false}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
