{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship Evidence Package",
  "type": "object",
  "required": ["schema_version", "package_id", "subject_ref", "finding", "evidence", "confidence", "alternatives", "review_state", "provenance_refs", "authority_claim"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"type": "string", "pattern": "^evidence-package:[a-z0-9][a-z0-9._:-]*$"},
    "subject_ref": {"type": "string", "pattern": "^relationship:[a-z0-9][a-z0-9._:-]*$"},
    "finding": {"type": "string"},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "alternatives": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "review_state": {"enum": ["unreviewed", "reviewed", "rejected"]},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(run|observation|relationship-evidence):[a-z0-9][a-z0-9._:-]*$"}},
    "authority_claim": {"const": "none"}
  },
  "additionalProperties": false
}
