{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic Chief of Staff Explanation",
  "type": "object",
  "required": ["schema_version", "subject_ref", "subject_type", "summary", "sources", "evidence_packages", "relationships", "confidence", "review_state", "uncertainties", "authority_context", "action_authority"],
  "properties": {
    "schema_version": {"const": 1},
    "subject_ref": {"type": "string"},
    "subject_type": {"enum": ["workspace", "storage_source", "workspace_item", "logical_resource", "representation", "project", "application", "workflow", "registry_entry", "recommendation", "unknown"]},
    "summary": {"type": "string"},
    "sources": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "relationships": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "review_state": {"enum": ["unreviewed", "reviewed", "approved", "rejected", "deferred"]},
    "uncertainties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authority_context": {
      "type": "object",
      "required": ["role", "scope", "basis"],
      "properties": {
        "role": {"enum": ["canonical", "deployment", "mirror", "backup", "archive", "unknown"]},
        "scope": {"enum": ["source_code", "curriculum_binary", "registry_metadata", "classroom_deployment", "backup_recovery", "application_bundle", "unknown"]},
        "basis": {"type": "string"}
      },
      "additionalProperties": false
    },
    "action_authority": {"const": "none"}
  },
  "additionalProperties": false
}
