{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human Interface Status",
  "type": "object",
  "required": ["schema_version", "title", "systems", "available_systems", "known_entities", "unresolved_items", "authority_state", "validation_status", "actions"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"const": "Chief of Staff Status"},
    "systems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "status", "detail"],
        "properties": {
          "name": {"enum": ["Resource Registry", "Workspace Model", "Relationships", "Recovery"]},
          "status": {"enum": ["OK", "WARN", "FAIL"]},
          "detail": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "available_systems": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "known_entities": {"type": "integer"},
    "unresolved_items": {"type": "integer"},
    "authority_state": {
      "type": "object",
      "required": ["assigned", "unknown", "conflicts"],
      "properties": {
        "assigned": {"type": "integer"},
        "unknown": {"type": "integer"},
        "conflicts": {"type": "integer"}
      },
      "additionalProperties": false
    },
    "validation_status": {"enum": ["PASS", "WARN", "FAIL"]},
    "actions": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
