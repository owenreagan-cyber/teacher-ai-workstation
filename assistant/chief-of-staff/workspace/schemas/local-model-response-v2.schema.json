{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase L.5F Closed-Reference Local Model Explanation Candidate v2",
  "type": "object",
  "required": ["schema_version", "response_id", "request_id", "context_id", "task", "subject_ref", "known_refs", "evidence_refs", "uncertainty_refs", "relationship_refs", "confidence", "authority", "review_state", "action_authority", "actions", "recommendations", "permissions", "access_claims"],
  "properties": {
    "schema_version": {"const": 2},
    "response_id": {"type": "string", "pattern": "^local-model-response-v2:[a-z0-9][a-z0-9._:-]*$"},
    "request_id": {"type": "string", "pattern": "^local-model-request:[a-z0-9][a-z0-9._:-]*$"},
    "context_id": {"type": "string", "pattern": "^ai-context-package:[a-z0-9][a-z0-9._:-]*$"},
    "task": {"const": "explain"},
    "subject_ref": {"type": "string"},
    "known_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^known:[0-9]{3}$"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence:[0-9]{3}$"}},
    "uncertainty_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^uncertainty:[0-9]{3}$"}},
    "relationship_refs": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "authority": {"enum": ["canonical", "deployment", "mirror", "backup", "archive", "unknown"]},
    "review_state": {"enum": ["unreviewed", "reviewed", "approved", "rejected", "deferred"]},
    "action_authority": {"const": "none"},
    "actions": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "recommendations": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "permissions": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "access_claims": {"type": "array", "maxItems": 0, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
