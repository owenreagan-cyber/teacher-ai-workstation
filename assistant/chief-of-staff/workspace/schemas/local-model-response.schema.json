{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase L.5D Structured Local Model Explanation Candidate",
  "type": "object",
  "required": ["schema_version", "response_id", "request_id", "context_id", "task", "claims", "confidence", "uncertainties", "authority_context", "review_state", "requested_actions", "recommendations", "permissions_claimed", "access_claims", "authority_effect", "validation_state"],
  "properties": {
    "schema_version": {"const": 1},
    "response_id": {"type": "string", "pattern": "^local-model-response:[a-z0-9][a-z0-9._:-]*$"},
    "request_id": {"type": "string", "pattern": "^local-model-request:[a-z0-9][a-z0-9._:-]*$"},
    "context_id": {"type": "string", "pattern": "^ai-context-package:[a-z0-9][a-z0-9._:-]*$"},
    "task": {"const": "explain"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["claim_id", "claim_type", "statement", "evidence_refs", "confidence"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^local-claim:[a-z0-9][a-z0-9._:-]*$"},
          "claim_type": {"enum": ["known", "evidence", "unknown"]},
          "statement": {"type": "string"},
          "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low", "unknown"]}
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject_ref", "value", "basis"],
        "properties": {
          "subject_ref": {"type": "string"},
          "value": {"enum": ["high", "medium", "low", "unknown"]},
          "basis": {"enum": ["deterministic_explanation", "evidence_package"]}
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authority_context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject_ref", "role", "scope", "basis"],
        "properties": {
          "subject_ref": {"type": "string"},
          "role": {"enum": ["canonical", "deployment", "mirror", "backup", "archive", "unknown"]},
          "scope": {"enum": ["source_code", "curriculum_binary", "registry_metadata", "classroom_deployment", "backup_recovery", "application_bundle", "unknown"]},
          "basis": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review_state": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["subject_ref", "state"],
        "properties": {
          "subject_ref": {"type": "string"},
          "state": {"enum": ["unreviewed", "reviewed", "approved", "rejected", "deferred"]}
        },
        "additionalProperties": false
      }
    },
    "requested_actions": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "recommendations": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "permissions_claimed": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "access_claims": {"type": "array", "maxItems": 0, "items": {"type": "string"}},
    "authority_effect": {"const": "none"},
    "validation_state": {"const": "candidate_not_executed"}
  },
  "additionalProperties": false
}
