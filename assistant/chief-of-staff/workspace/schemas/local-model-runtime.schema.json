{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase L.5E Ollama Loopback Runtime Policy",
  "type": "object",
  "required": ["schema_version", "phase", "policy_id", "runtime", "transport", "host_policy", "endpoint", "approved_hosts", "port", "approved_models", "approved_tasks", "timeout_seconds", "maximum_attempts", "maximum_response_bytes", "streaming_enabled", "thinking_output_enabled", "tools_enabled", "vision_enabled", "cloud_fallback_enabled", "model_fallback_enabled", "automatic_retry_enabled", "automatic_pull_enabled", "automatic_startup_enabled", "runtime_audit_persistence_enabled", "raw_response_persistence_enabled", "hidden_reasoning_persistence_enabled", "action_execution_enabled"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"const": "L.5E"},
    "policy_id": {"const": "ollama-loopback-explain-runtime"},
    "runtime": {"const": "ollama"},
    "transport": {"const": "http"},
    "host_policy": {"const": "loopback_only"},
    "endpoint": {"const": "http://127.0.0.1:11434"},
    "approved_hosts": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["127.0.0.1", "localhost"]}},
    "port": {"const": 11434},
    "approved_models": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "qwen3.5:35b"}},
    "approved_tasks": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "explain"}},
    "timeout_seconds": {"const": 120},
    "maximum_attempts": {"const": 1},
    "maximum_response_bytes": {"const": 1000000},
    "streaming_enabled": {"const": false},
    "thinking_output_enabled": {"const": false},
    "tools_enabled": {"const": false},
    "vision_enabled": {"const": false},
    "cloud_fallback_enabled": {"const": false},
    "model_fallback_enabled": {"const": false},
    "automatic_retry_enabled": {"const": false},
    "automatic_pull_enabled": {"const": false},
    "automatic_startup_enabled": {"const": false},
    "runtime_audit_persistence_enabled": {"const": false},
    "raw_response_persistence_enabled": {"const": false},
    "hidden_reasoning_persistence_enabled": {"const": false},
    "action_execution_enabled": {"const": false}
  },
  "additionalProperties": false
}
