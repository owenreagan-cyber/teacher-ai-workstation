{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic Query",
  "type": "object",
  "required": ["schema_version", "query_id", "query_type", "target_ref", "filters", "scope", "permission_grants", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "query_id": {"type": "string", "pattern": "^query:[a-z0-9][a-z0-9._:-]*$"},
    "query_type": {"enum": ["entity_lookup", "relationship_lookup", "evidence_lookup", "recovery_candidate_lookup", "project_lookup", "application_lookup", "resource_lookup"]},
    "target_ref": {"type": "string"},
    "filters": {
      "type": "object",
      "properties": {
        "relationship_type": {"enum": ["belongs_to_project", "representation_of", "used_by_application", "deployed_to", "mirrored_to", "backed_up_by", "version_of", "supersedes", "referenced_by_registry", "expected_artifact_of"]},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "review_state": {"enum": ["unreviewed", "reviewed", "approved", "rejected", "deferred"]},
        "classification": {"enum": ["public", "teacher_internal", "student_safe", "student_private", "restricted", "unknown"]}
      },
      "additionalProperties": false
    },
    "scope": {"enum": ["active", "classroom_ready", "teacher_only", "student_safe", "restricted", "superseded", "all", "unreviewed", "conflicts"]},
    "permission_grants": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "additionalProperties": false
}
