{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recovery Evidence Package",
  "type": "object",
  "required": ["schema_version", "package_id", "shared_evidence_package", "finding", "subject", "candidate", "evidence", "confidence", "unknowns", "alternatives", "recommended_next_step", "review_state", "authority_effect"],
  "properties": {
    "schema_version": {"const": 1},
    "package_id": {"type": "string", "pattern": "^recovery-evidence:[a-z0-9][a-z0-9._:-]*$"},
    "shared_evidence_package": {"type": "object"},
    "finding": {"type": "string"},
    "subject": {"type": "string"},
    "candidate": {"type": "string"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["type", "source", "detail", "strength"],
        "properties": {
          "type": {"enum": ["resource_registry_metadata", "knowledge_vault_reference", "project_observation", "application_observation", "relationship", "authority_assertion", "filename_similarity", "structural_evidence"]},
          "source": {"type": "string"},
          "detail": {"type": "string"},
          "strength": {"enum": ["high", "medium", "low", "unknown"]}
        },
        "additionalProperties": false
      }
    },
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "unknowns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "alternatives": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "recommended_next_step": {"const": "review_candidate"},
    "review_state": {"const": "unreviewed"},
    "authority_effect": {"const": "none"}
  },
  "additionalProperties": false
}
