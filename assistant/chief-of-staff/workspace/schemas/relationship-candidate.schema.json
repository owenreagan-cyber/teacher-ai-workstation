{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship Candidate",
  "type": "object",
  "required": ["schema_version", "relationship_id", "relationship_type", "source_ref", "target_ref", "assertion_type", "confidence", "evidence", "provenance", "observed_at", "review_state", "authority_claim", "ownership_effect", "permission_effect", "action_effect"],
  "properties": {
    "schema_version": {"const": 1},
    "relationship_id": {"type": "string", "pattern": "^relationship:[a-z0-9][a-z0-9._:-]*$"},
    "relationship_type": {"enum": ["belongs_to_project", "representation_of", "used_by_application", "deployed_to", "mirrored_to", "backed_up_by", "version_of", "supersedes", "referenced_by_registry", "expected_artifact_of"]},
    "source_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._:-]*$"},
    "target_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._:-]*$"},
    "assertion_type": {"enum": ["observed", "inferred", "owner_asserted", "registry_asserted"]},
    "confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "evidence": {
      "type": "object",
      "required": ["package_id", "evidence_refs"],
      "properties": {
        "package_id": {"type": "string", "pattern": "^evidence-package:[a-z0-9][a-z0-9._:-]*$"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_phase", "source_observation_ref", "rule_id"],
      "properties": {
        "source_phase": {"enum": ["D", "E", "F"]},
        "source_observation_ref": {"type": "string", "pattern": "^observation:[a-z0-9][a-z0-9._:-]*$"},
        "rule_id": {"enum": ["approved_project_mapping", "declared_application_mapping", "approved_source_mapping", "observed_representation"]}
      },
      "additionalProperties": false
    },
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "review_state": {"enum": ["unreviewed", "reviewed", "rejected"]},
    "authority_claim": {"const": "none"},
    "ownership_effect": {"const": "none"},
    "permission_effect": {"const": "none"},
    "action_effect": {"const": "none"}
  },
  "additionalProperties": false
}
