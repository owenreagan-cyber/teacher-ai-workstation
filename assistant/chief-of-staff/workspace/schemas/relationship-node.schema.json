{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relationship Graph Node",
  "type": "object",
  "required": ["schema_version", "node_id", "node_type", "label", "evidence_refs", "review_state", "authority_claim"],
  "properties": {
    "schema_version": {"const": 1},
    "node_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z0-9][a-z0-9._:-]*$"},
    "node_type": {"enum": ["Workspace", "StorageSource", "WorkspaceItem", "LogicalResource", "Representation", "Project", "ApplicationConcept", "ApplicationInstance", "Workflow", "RegistryEntry", "Observation", "Recommendation"]},
    "label": {"type": "string"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "review_state": {"enum": ["unreviewed", "reviewed", "rejected"]},
    "authority_claim": {"const": "none"}
  },
  "additionalProperties": false
}
