// While stopped: exit 3, no answer text, no session append, no tool/model execution, and a stop audit record.
{"id": "ks-fp-001", "setup": ["stop"], "prompt": "what time is it", "expect": {"exit_code": 3, "error_kind": "stopped", "no_answer": true, "audit_kinds_include": ["request_stopped"], "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}
{"id": "ks-model-001", "setup": ["stop"], "prompt": "what's on my calendar today", "expect": {"exit_code": 3, "error_kind": "stopped", "no_answer": true, "audit_kinds_include": ["request_stopped"], "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}
{"id": "ks-text-001", "setup": ["stop"], "prompt": "what's the weather", "json": false, "expect": {"exit_code": 3, "no_output": true, "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}
{"id": "ks-session-001", "session": "ks-s1", "setup": ["stop"], "prompt": "what time is it", "expect": {"exit_code": 3, "no_answer": true, "session_unchanged": true, "session_turns": 0, "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}
{"id": "ks-session-002", "session": "ks-s2", "turns": [{"prompt": "what's on my calendar today", "expect": {"exit_code": 0, "session_turns": 1}}, {"command": "stop", "expect": {"exit_code": 0}}, {"prompt": "and my reminders?", "expect": {"exit_code": 3, "no_answer": true, "session_unchanged": true, "session_turns": 1, "audit_kinds_include": ["request_stopped"], "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}, {"command": "history", "expect": {"exit_code": 0, "history_turns": 1, "history_skipped": 0}}]}
{"id": "ks-brief-001", "setup": ["stop"], "command": "brief", "expect": {"exit_code": 3, "error_kind": "stopped", "no_answer": true, "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}
{"id": "ks-brief-002", "setup": ["stop"], "command": "brief", "json": false, "expect": {"exit_code": 3, "no_output": true, "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}
{"id": "ks-status-001", "setup": ["stop"], "command": "status", "expect": {"exit_code": 0, "output_contains": ["\"kill_switch\": true", "\"fixture\": true"], "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}
{"id": "ks-resume-001", "setup": ["stop", "resume"], "prompt": "what time is it", "expect": {"exit_code": 0, "fast_path": true, "answer_contains": ["2:30 PM"], "model_calls": 0}}
{"id": "ks-cycle-001", "session": "ks-cycle", "turns": [{"prompt": "what time is it", "expect": {"exit_code": 0, "session_turns": 1}}, {"command": "stop", "expect": {"exit_code": 0}}, {"prompt": "how's the weather for recess", "expect": {"exit_code": 3, "no_answer": true, "session_turns": 1, "audit_kinds_exclude": ["tool_result", "model_call", "answer"]}}, {"command": "brief", "expect": {"exit_code": 3, "no_answer": true}}, {"command": "resume", "expect": {"exit_code": 0}}, {"prompt": "how's the weather for recess", "expect": {"exit_code": 0, "min_model_calls": 1, "session_turns": 2}}]}
