{"id": "rb-config-002", "state_mutation": {"config_raw": "{\"ollama_url\": \"https://api.example.com\"}"}, "prompt": "what's on my calendar today", "expect": {"exit_code": 2, "error_kind": "usage", "no_answer": true, "model_calls": 0}}
